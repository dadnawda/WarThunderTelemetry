<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WarThunderTelemetry.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WarThunderTelemetry.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="战雷遥测仪表台">

    <Grid Background="{ThemeResource WtPageBackgroundBrush}">
        <!--
            必须把内置的 Settings 项关掉（IsSettingsVisible="False"）。
            它的 Tag 为 null，会被 OnNavSelectionChanged 的 `_ =>` 兜底成 DashboardPage，
            导致选中态停在内置设置项上、内容区却不切换 —— 表现为「进去就出不来」。
            我们用自己的「设置」菜单项（Tag="settings"）代替。
        -->
        <NavigationView x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="仪表盘" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="全字段" Tag="raw">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部状态条：连接状态 + 载具 + 告警 -->
                <Border Grid.Row="0"
                        Background="{ThemeResource WtCardBackgroundBrush}"
                        BorderBrush="{ThemeResource WtCardBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                     Fill="{ThemeResource WtDisconnectedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="未连接" FontSize="13"
                                       Foreground="{ThemeResource WtSecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="VehicleText" Text="载具：—" FontSize="13"
                                   Foreground="{ThemeResource WtSecondaryTextBrush}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" x:Name="AlertText" Text="" FontSize="13"
                                   Foreground="{ThemeResource WtAlertCriticalBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="HudButton" Content="显示悬浮窗" Click="OnToggleHudClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 页面容器 -->
                <Frame Grid.Row="1" x:Name="ContentFrame" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WarThunderTelemetry.App.Views.RawFieldsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索框 + 来源筛选 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="搜索字段名…"
                     Width="260"
                     TextChanged="OnSearchChanged" />
            <ComboBox x:Name="SourcePicker" Width="180" SelectionChanged="OnSourceChanged">
                <ComboBoxItem Content="全部来源" IsSelected="True" />
                <ComboBoxItem Content="state" />
                <ComboBoxItem Content="indicators" />
                <ComboBoxItem Content="derived" />
            </ComboBox>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="13"
                       Foreground="{ThemeResource WtSecondaryTextBrush}" />
        </StackPanel>

        <!-- 字段表格 -->
        <Border Grid.Row="1"
                Background="{ThemeResource WtCardBackgroundBrush}"
                BorderBrush="{ThemeResource WtCardBorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <ListView x:Name="FieldList" SelectionMode="None" Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding RawKey}" FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource WtPrimaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource WtDataValueBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding SourceDisplay}" FontSize="12"
                                       Foreground="{ThemeResource WtSecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding LocalDisplay}" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource WtMutedTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>

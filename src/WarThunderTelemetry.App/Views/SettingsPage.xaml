<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WarThunderTelemetry.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="数据源" FontSize="15" FontWeight="SemiBold"
                       Foreground="{ThemeResource WtPrimaryTextBrush}" />

            <Border Background="{ThemeResource WtCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WtCardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="MockToggle"
                                  Header="使用内置模拟数据（无游戏时调试界面）"
                                  Toggled="OnMockToggled" />

                    <NumberBox x:Name="PortBox"
                               Header="游戏本机接口端口（默认 8111）"
                               Minimum="1" Maximum="65535"
                               SpinButtonPlacementMode="Compact"
                               ValueChanged="OnPortChanged" />

                    <NumberBox x:Name="StateIntervalBox"
                               Header="/state 轮询间隔（毫秒）"
                               Minimum="50" Maximum="2000"
                               SpinButtonPlacementMode="Compact"
                               ValueChanged="OnIntervalChanged" />

                    <NumberBox x:Name="IndicatorsIntervalBox"
                               Header="/indicators 轮询间隔（毫秒）"
                               Minimum="50" Maximum="2000"
                               SpinButtonPlacementMode="Compact"
                               ValueChanged="OnIntervalChanged" />

                    <TextBlock Text="游戏内需开启接口：选项 → 游戏 → War Thunder 接口"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />

                    <InfoBar x:Name="RestartHint"
                             IsOpen="True"
                             IsClosable="False"
                             Visibility="Collapsed"
                             Severity="Informational"
                             Title="数据源设置已保存"
                             Message="重启应用后生效。当前采集仍在用旧设置运行。" />
                </StackPanel>
            </Border>

            <TextBlock Text="载具参数与告警阈值" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{ThemeResource WtPrimaryTextBrush}" />

            <Border Background="{ThemeResource WtCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WtCardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="告警阈值按载具自动设定。参数取自游戏官方 wiki 的性能限制区，缓存到本地后不再重复联网。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />

                    <ToggleSwitch x:Name="OnlineLookupToggle"
                                  Header="允许联网获取未收录载具的参数（关掉则纯离线运行）"
                                  Toggled="OnOnlineLookupToggled" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新当前载具参数" Click="OnRefreshVehicleClick" />
                        <Button Content="清空载具缓存" Click="OnClearVehicleCacheClick" />
                    </StackPanel>

                    <TextBlock x:Name="VehicleCacheText"
                               Text="缓存：—"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtSecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="悬浮窗外观" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{ThemeResource WtPrimaryTextBrush}" />

            <Border Background="{ThemeResource WtCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WtCardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="显示 / 关闭悬浮窗" Click="OnToggleHudClick" />
                        <Button Content="重置悬浮窗位置与尺寸" Click="OnResetHudBoundsClick" />
                    </StackPanel>

                    <ToggleSwitch x:Name="HudLockToggle"
                                  Header="锁定悬浮窗（锁定后鼠标点击穿透到游戏，不可拖动/拉伸）"
                                  Toggled="OnHudLockToggled" />

                    <ToggleSwitch x:Name="HudPanelBgToggle"
                                  Header="显示背景面板（关掉则只有文字浮在画面上，完全透明）"
                                  Toggled="OnHudPanelBgToggled" />

                    <ToggleSwitch x:Name="HudResizeHintToggle"
                                  Header="显示右下角拉扯提示（纯文字模式下默认隐藏，避免任何边框感）"
                                  Toggled="OnHudResizeHintToggled" />

                    <Slider x:Name="HudBgOpacitySlider"
                            Header="背景不透明度（调到 0 等于全透明）"
                            Minimum="0" Maximum="1" StepFrequency="0.05"
                            ValueChanged="OnHudBgOpacityChanged" />

                    <Slider x:Name="HudFontSizeSlider"
                            Header="字号"
                            Minimum="12" Maximum="36" StepFrequency="1"
                            ValueChanged="OnHudFontSizeChanged" />

                    <ToggleSwitch x:Name="HudCompactToggle"
                                  Header="紧凑行距（同样高度能多显示几行）"
                                  Toggled="OnHudCompactToggled" />

                    <TextBlock Text="颜色" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"
                               Foreground="{ThemeResource WtPrimaryTextBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="名称文字" FontSize="12"
                                       Foreground="{ThemeResource WtSecondaryTextBrush}" />
                            <ColorPicker x:Name="HudTitleColorPicker"
                                         IsAlphaEnabled="False"
                                         IsColorChannelTextInputVisible="False"
                                         IsHexInputVisible="True"
                                         ColorChanged="OnHudTitleColorChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="数值文字" FontSize="12"
                                       Foreground="{ThemeResource WtSecondaryTextBrush}" />
                            <ColorPicker x:Name="HudValueColorPicker"
                                         IsAlphaEnabled="False"
                                         IsColorChannelTextInputVisible="False"
                                         IsHexInputVisible="True"
                                         ColorChanged="OnHudValueColorChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="背景颜色" FontSize="12"
                                       Foreground="{ThemeResource WtSecondaryTextBrush}" />
                            <ColorPicker x:Name="HudBgColorPicker"
                                         IsAlphaEnabled="False"
                                         IsColorChannelTextInputVisible="False"
                                         IsHexInputVisible="True"
                                         ColorChanged="OnHudBgColorChanged" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="深色主题配色" Click="OnHudPresetDarkClick" />
                        <Button Content="浅色主题配色" Click="OnHudPresetLightClick" />
                        <Button Content="荧光绿配色" Click="OnHudPresetNeonClick" />
                    </StackPanel>

                    <TextBlock Text="提示：解锁状态下，悬浮窗整块都能拖动（按住任意位置），四边四角可拉伸。锁定后鼠标完全穿透到游戏，需回此页解锁。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />

                    <TextBlock Text="游戏需使用「无边框窗口」或「窗口化」模式。独占全屏下任何非注入叠加层都无法显示。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="悬浮窗字段（与仪表盘分开）" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{ThemeResource WtPrimaryTextBrush}" />

            <Border Background="{ThemeResource WtCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WtCardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="悬浮窗只显示这里勾选的字段。悬浮窗上地方有限，建议只留最关键的几项；仪表盘则用下面那份更全的列表。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="跟随仪表盘设置" Click="OnHudFieldsFollowDashboardClick" />
                        <Button Content="恢复默认 7 项" Click="OnHudFieldsResetClick" />
                        <Button Content="全选" Click="OnHudFieldsAllClick" />
                        <Button Content="全不选" Click="OnHudFieldsNoneClick" />
                    </StackPanel>

                    <ItemsControl x:Name="HudFieldCheckList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="武器发射参数悬浮区" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{ThemeResource WtPrimaryTextBrush}" />

            <Border Background="{ThemeResource WtCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WtCardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="独立的第二个悬浮区域，显示当前挂载导弹的最佳发射参数。全部本地计算，不联网。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="显示 / 关闭武器悬浮区" Click="OnToggleWeaponHudClick" />
                        <Button Content="重置位置与尺寸" Click="OnResetWeaponBoundsClick" />
                    </StackPanel>

                    <ToggleSwitch x:Name="WeaponFollowHudColorsToggle"
                                  Header="配色跟随悬浮窗（参数界面）"
                                  Toggled="OnWeaponFollowHudColorsToggled" />

                    <TextBlock Text="默认开着：武器区的文字与背景配色自动跟随上面那套「悬浮窗外观」。同屏两个悬浮窗看起来就是一套，改一次即可。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />

                    <ToggleSwitch x:Name="WeaponLockToggle"
                                  Header="锁定武器悬浮区（锁定后鼠标穿透）"
                                  Toggled="OnWeaponLockToggled" />

                    <ToggleSwitch x:Name="WeaponOwnStateToggle"
                                  Header="显示本机速度 / 高度 / 过载三行"
                                  Toggled="OnWeaponOwnStateToggled" />

                    <ToggleSwitch x:Name="WeaponPanelBgToggle"
                                  Header="显示背景面板（关掉则纯文字浮在画面上）"
                                  Toggled="OnWeaponPanelBgToggled" />

                    <Slider x:Name="WeaponBgOpacitySlider"
                            Header="背景不透明度"
                            Minimum="0" Maximum="1" StepFrequency="0.05"
                            ValueChanged="OnWeaponBgOpacityChanged" />

                    <Slider x:Name="WeaponFontSizeSlider"
                            Header="字号"
                            Minimum="10" Maximum="32" StepFrequency="1"
                            ValueChanged="OnWeaponFontSizeChanged" />

                    <TextBlock Text="导弹型号" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"
                               Foreground="{ThemeResource WtPrimaryTextBrush}" />

                    <TextBlock Text="默认从游戏挂载自动识别。识别不到（或识别错误）时可在这里手动指定。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />

                    <ComboBox x:Name="WeaponMissileBox"
                              Header="指定导弹"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnWeaponMissileChanged" />

                    <TextBlock x:Name="WeaponMissileInfoText"
                               Text=""
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtSecondaryTextBrush}" />

                    <TextBlock Text="目标信息（可选）" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"
                               Foreground="{ThemeResource WtPrimaryTextBrush}" />

                    <TextBlock Text="8111 接口不提供雷达目标数据，因此目标的距离与态势需要手动填写。填了才能给出「可发射 / 太远 / 太近」的精确判断；不填则只显示该弹在当前本机状态下的射程区间。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <NumberBox x:Name="TargetDistanceBox" Grid.Column="0"
                                   Header="目标距离（米）"
                                   Minimum="0" Maximum="200000"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="OnTargetInputChanged" />

                        <NumberBox x:Name="TargetSpeedBox" Grid.Column="1"
                                   Header="目标速度（km/h）"
                                   Minimum="0" Maximum="3000"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="OnTargetInputChanged" />

                        <NumberBox x:Name="TargetAltBox" Grid.Column="2"
                                   Header="目标高度（米）"
                                   Minimum="0" Maximum="25000"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="OnTargetInputChanged" />
                    </Grid>

                    <ComboBox x:Name="TargetAspectBox"
                              Header="交战态势"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnTargetAspectChanged">
                        <ComboBoxItem Content="未指定" Tag="unknown" />
                        <ComboBoxItem Content="迎头（雷达弹有利）" Tag="head-on" />
                        <ComboBoxItem Content="尾追（红外弹有利）" Tag="tail-on" />
                        <ComboBoxItem Content="侧向" Tag="side-on" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="清空目标信息" Click="OnClearTargetClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="显示字段" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{ThemeResource WtPrimaryTextBrush}" />

            <Border Background="{ThemeResource WtCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WtCardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="勾选仪表盘要显示的字段（默认已勾选 7 项常见飞行数据）。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource WtMutedTextBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="恢复默认 7 项" Click="OnResetFieldsClick" />
                        <Button Content="全选" Click="OnSelectAllClick" />
                        <Button Content="全不选" Click="OnSelectNoneClick" />
                    </StackPanel>

                    <ItemsControl x:Name="FieldCheckList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WarThunderTelemetry.App</RootNamespace>
    <AssemblyName>WarThunderTelemetry</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>

    <!-- 非打包模式：无需 Package.appxmanifest，直接 F5 即可运行。
         悬浮窗的鼠标穿透与全局热键在非打包下不受 AppContainer 限制。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- 自包含发布：把 Windows App SDK 运行时随程序一起输出。
         这样就不再依赖目标机预装 WindowsAppRuntime 的
         Framework / Main / Singleton 三个包 —— 那三个包缺一个，
         非打包应用就会在托管代码执行前直接被引导程序掐掉
         （表现为弹「requires Windows App Runtime」对话框，退出码 0x80670016）。 -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- LibraryImport 源生成器（P/Invoke）会产出 unsafe 代码，必须开启。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WarThunderTelemetry.Core\WarThunderTelemetry.Core.csproj" />
  </ItemGroup>

  <!-- ============================================================
       WinUI 3 已知问题：/t:Publish 不会把编译后的 XAML 产物带进发布目录。

       Publish 的目标是为 MSIX 打包设计的，它把 .pri 资源索引和各页面的
       .xbf（编译后的二进制 XAML）当成"打包阶段再处理"的内容，于是发布
       目录里只有 exe/dll，缺这两样。

       后果：发布版一启动就在 MainWindow.InitializeComponent() 抛
       XamlParseException: XAML parsing failed，而 Debug 能跑
       （bin 目录里是有这些文件的），极难一眼看出原因。

       这里在 Publish 之后手动补齐，保证发布目录可直接分发。
       ============================================================ -->
  <Target Name="CopyXamlArtifactsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XamlArtifact Include="$(TargetDir)$(AssemblyName).pri" />
      <_XamlArtifact Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>

    <Copy SourceFiles="@(_XamlArtifact)"
          DestinationFiles="@(_XamlArtifact->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
